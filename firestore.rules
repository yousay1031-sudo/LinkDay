rules_version = '2';

// ============================================================
// LinkDay Firestore セキュリティルール
//
// 【前提】
// - 業務データ（顧客・週間利用計画・出席・送迎計画・設定・職員）は
//   facilities/{facilityId}/ の下に置き、複数の端末で共有する。
//   児童の個人情報を含むため、その事業所に所属するアカウントだけが読み書きできる。
// - 所属は最上位の memberships/{uid}（{ facilityId }）で表す。
//   クライアントは自分の分を読めるだけで、作成・変更はできない
//   （登録は管理者が Firebase コンソール／Admin SDK で行う）。
// - LINE 連携用のコレクション（line_linkage 以下）は、有効な所属のあるアカウントだけ
//   （ステップ2で「認証済みなら誰でも」から締めた）。
// - Cloud Functions は Admin SDK で動作するため、本ルールを
//   バイパスする（lineWebhook は未認証の LINE からの呼び出しだが、
//   x-line-signature の HMAC 検証を通過したものだけが Firestore に書く）。
// - ログインは 2 種類（ステップ2）。
//   共用端末アカウント（事業所の PC・タブレット）: 誰が操作したかはアプリ内で
//     担当者を選んで updatedByStaffId / updatedByStaffName に残す（本人確認ではない）。
//   個人アカウント（職員の Google アカウント）: 担当者はログインした本人に固定。
//     ルールでも本人の職員 ID でしか記録できない（hasAudit）。
//
// 【原則】
// 1. 未認証（request.auth == null）は全コレクション全面拒否。
//    認証済みでも、有効な所属（memberships/{uid}）が無ければ全面拒否
//    （自分の所属の文書を読むことだけはできる）。
// 2. facilities/{facilityId}/** は「ログイン済み かつ その事業所に所属」の場合だけ。
//    「ログイン済みなら誰でも」にはしない。他事業所のデータは読めない。
// 3. 業務データの作成・更新には updatedAt（サーバー時刻）と担当者名を必須にする。
// 4. 顧客・職員は削除しない（在籍終了 = isActive:false）。削除は拒否する。
// 5. 明示的に許可したコレクション以外は全面拒否（最後の match /{document=**}）。
// 6. notification_logs はクライアントから作成・更新・削除できない
//    （冪等キーを兼ねるため、改変されると二重送信が可能になる）。
//    作成は Cloud Functions（Admin SDK）のみ。クライアントは read のみ。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 共通ヘルパー ───────────────────────────────────────
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // 6 桁英数（数字＋大文字英字）の連携コードか
    function isValidCode(code) {
      return code is string && code.matches('^[0-9A-Z]{6}$');
    }

    // LINE userId: 'U' + 32 桁 16 進英数字
    function isValidLineUserId(id) {
      return id is string && id.matches('^U[0-9a-fA-F]{32}$');
    }

    // ── 所属（ステップ2: 個人アカウントを追加）─────────────────
    // memberships/{uid} = { facilityId, kind, staffId, email, createdAt }
    //   kind: 'shared'（共用端末アカウント。kind が無い所属もこれ）
    //       | 'personal'（職員個人の Google アカウント。staffId の本人）
    // 所属を作る・消すのは Cloud Functions だけ（クライアントは書けない）。
    //
    // 【安全の前提】誰でも Firebase のアカウントを作れても（Google ログインを
    // 有効にすると誰でも作れる）、有効な所属が無ければ何も読めず何も書けない。
    // 個人アカウントの所属は、ひも付く職員が「在籍中かつログイン許可」のときだけ
    // 有効とする（在籍終了・ログイン停止は、Functions が所属を消すのを待たずに、
    // その時点から拒否される）。
    function membershipPath() {
      return /databases/$(database)/documents/memberships/$(request.auth.uid);
    }

    function staffPath(facilityId, staffId) {
      return /databases/$(database)/documents/facilities/$(facilityId)/staff/$(staffId);
    }

    function isPersonal(m) {
      return m.get('kind', 'shared') == 'personal';
    }

    // 【文書の読み取りの回数】ルール 1 回の評価で読める文書の回数には上限がある
    // （1 件の読み書きで 10 回）。所属・職員の文書は、ここの関数で 1 回ずつだけ読む。
    // 所属や職員の文書が無いときの get() は評価エラーになり、拒否として扱われる。
    function myMembership() {
      return get(membershipPath()).data;
    }

    // 職員の文書が「在籍中かつログイン許可」か
    function staffCanLogin(s) {
      return s.get('isActive', false) == true && s.get('loginEnabled', false) == true;
    }

    // 所属の文書 m が有効か（共用端末なら常に有効。個人なら職員が在籍中かつログイン許可）
    function membershipOk(m) {
      return m.facilityId is string
        && (!isPersonal(m)
          || (m.get('staffId', null) is string
            && staffCanLogin(get(staffPath(m.facilityId, m.staffId)).data)));
    }

    // 有効な所属があるか（事業所を問わない。LINE 連携の最上位コレクション用）
    function hasValidMembership() {
      return isSignedIn() && membershipOk(myMembership());
    }

    // その事業所に有効な所属があるか
    function isMemberOf(facilityId) {
      return isSignedIn() && memberOfWith(myMembership(), facilityId);
    }

    function memberOfWith(m, facilityId) {
      return m.facilityId == facilityId && membershipOk(m);
    }

    // 業務データの書き込みに担当者の記録が付いているか。
    // 個人アカウントは本人の職員 ID でしか記録できない（他人の名前で記録させない）。
    // 例外は画面を開いたときの自動処理（担当者 ID なし・名前「自動」）だけ。
    function hasAudit() {
      let d = request.resource.data;
      let m = myMembership();
      return d.updatedAt == request.time
        && d.updatedByStaffName is string
        && d.updatedByStaffName.size() > 0
        && (d.updatedByStaffId == null || d.updatedByStaffId is string)
        && (!isPersonal(m)
          || d.updatedByStaffId == m.staffId
          || (d.updatedByStaffId == null && d.updatedByStaffName == '自動'));
    }

    // ── 管理者（ステップ2）──────────────────────────────────
    // 「個人アカウントで、ひも付く職員が在籍中・ログイン許可・管理者」のときだけ。
    // 共用端末アカウントは、担当者に管理者の名前を選んでいても管理者にならない
    // （名前を選ぶだけで管理者になれてしまうため）。
    function isAdminOf(facilityId) {
      let m = myMembership();
      return isSignedIn() && memberOfWith(m, facilityId) && isPersonal(m)
        && get(staffPath(facilityId, m.staffId)).data.get('isAdmin', false) == true;
    }

    // 職員・メールアドレス・ログイン履歴（汎用の業務データのルールでは扱わない）
    function ACCOUNT_COLLECTIONS() {
      return ['staff', 'staffAccounts', 'loginHistory'];
    }

    // 専用のルールだけで判定するコレクション（汎用の業務データのルールから外す。
    // ルールは「どれか 1 つが許せば通る」ため、汎用のルールに残すと専用の条件を素通りする）
    function OWN_RULE_COLLECTIONS() {
      return ACCOUNT_COLLECTIONS().concat(['dailyJournals', 'supportPlans']);
    }

    // ── 個別支援計画（ステップ3）──────────────────────────────
    // 1 計画 1 文書（支援の表の行は計画の中）。所属する全員が読める（承認済みの判断点1 (A)）。
    function isDateOrNull(v) {
      return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // 計画の形。同意済みなら、説明した日と同意を得た日がある（作成中なら同意を得た日は空）。
    // 同意後の修正の記録は、同意済みの計画にだけ付く。
    function validPlan() {
      let d = request.resource.data;
      return d.keys().hasOnly(['customerId', 'customerName', 'birthday', 'createdOn',
             'managerStaffId', 'managerName', 'texts', 'rows', 'explainedOn', 'agreedOn',
             'status', 'assessmentDoneOn', 'copiedFromPlanId',
             'revisedAfterAgreementAt', 'revisedAfterAgreementByStaffId',
             'revisedAfterAgreementByStaffName',
             'createdAt', 'updatedAt', 'updatedByStaffId', 'updatedByStaffName'])
        && d.customerId is string && d.customerId.size() > 0
        && d.status in ['draft', 'agreed']
        && d.texts is map && d.texts.size() <= 30
        && d.rows is list && d.rows.size() <= 60
        && isDateOrNull(d.get('createdOn', null))
        && isDateOrNull(d.get('explainedOn', null))
        && isDateOrNull(d.get('agreedOn', null))
        && isDateOrNull(d.get('assessmentDoneOn', null))
        && (d.status == 'agreed') == (d.get('agreedOn', null) != null)
        && (d.status == 'draft' || d.get('explainedOn', null) != null)
        && (d.status == 'agreed' || d.get('revisedAfterAgreementAt', null) == null);
    }

    // 同意済みの計画の更新は、次のどれかの形だけ（承認済みの判断点6）。
    //   1. アセスメントを実施した日だけを入れる（中身は変えない）
    //   2. 軽い修正: 同意済みのまま、説明した日・同意を得た日は変えず、
    //      「同意後に修正した日時と担当者」を今の時刻・この書き込みの担当者で残す
    //   3. 内容を変える: 作成中に戻し、説明した日・同意を得た日を空にする
    function agreedPlanUpdateOk() {
      let d = request.resource.data;
      let before = resource.data;
      return d.diff(before).affectedKeys().hasOnly(
               ['assessmentDoneOn', 'updatedAt', 'updatedByStaffId', 'updatedByStaffName'])
        || (d.status == 'agreed'
          && d.agreedOn == before.agreedOn
          && d.explainedOn == before.explainedOn
          && d.get('revisedAfterAgreementAt', null) == request.time
          && d.get('revisedAfterAgreementByStaffId', null) == d.get('updatedByStaffId', null)
          && d.get('revisedAfterAgreementByStaffName', null) == d.updatedByStaffName)
        || (d.status == 'draft'
          && d.get('agreedOn', null) == null
          && d.get('explainedOn', null) == null);
    }

    // ── 業務日誌（ステップ3）────────────────────────────────
    // 文書 ID は日付（YYYY-MM-DD）。同じ日の日誌は 2 つできない。
    // 未来の日（日本時間の今日より後）は作れない。項目は決めたものだけ。
    function validJournal(dateKey) {
      let d = request.resource.data;
      let p = dateKey.split('-');
      return dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.date == dateKey
        && timestamp.date(int(p[0]), int(p[1]), int(p[2]))
             <= request.time + duration.value(9, 'h')
        && d.keys().hasOnly(['date', 'staff', 'activities', 'note',
             'createdAt', 'updatedAt', 'updatedByStaffId', 'updatedByStaffName'])
        && d.staff is list && d.staff.size() <= 100
        && d.activities is list && d.activities.size() <= 50
        && d.note is string && d.note.size() <= 4000;
    }

    // 職員の文書のうち管理者だけが変えられる項目（lib/models/staff.dart と一致させる）
    function PROTECTED_STAFF_FIELDS() {
      return ['isActive', 'deactivatedAt', 'isAdmin', 'loginEnabled',
              'hasGoogleEmail', 'pinHash', 'pinSalt', 'otherAdminId'];
    }

    // 管理者として働ける職員の文書か
    function isEffectiveAdmin(d) {
      return d.get('isActive', false) == true
        && d.get('isAdmin', false) == true
        && d.get('loginEnabled', false) == true;
    }

    // 管理者による職員の更新で、管理者が 1 人もいなくならないこと。
    // 管理者を減らす変更（在籍終了・管理者の解除・ログインの停止）には、
    // 残る別の管理者の職員 ID を otherAdminId に付けさせ、その人を確かめる。
    // 既知の制限: 2 人の管理者が同時にお互いを外すと、両方が通りうる（手順書に記載）。
    function keepsAnAdmin(facilityId, staffId) {
      let other = request.resource.data.get('otherAdminId', null);
      return !(isEffectiveAdmin(resource.data) && !isEffectiveAdmin(request.resource.data))
        || (other is string && other != staffId
          && isEffectiveAdmin(get(staffPath(facilityId, other)).data));
    }

    // メールアドレスの文書の形（空文字は「登録を外した」）
    function validAccountEmail(d) {
      return d.googleEmail is string
        && d.googleEmailLower == d.googleEmail.lower()
        && (d.googleEmail == ''
          || d.googleEmail.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$'));
    }

    // ログイン履歴の 1 件として正しいか（自分の所属の種類・職員と一致すること）
    function validLoginEntry(entryId) {
      let d = request.resource.data;
      let m = myMembership();
      return entryId == request.auth.uid + '_' + string(request.auth.token.auth_time)
        && d.keys().hasOnly(['uid', 'kind', 'staffId', 'staffName', 'at', 'authTime'])
        && d.uid == request.auth.uid
        && d.at == request.time
        && d.authTime == request.auth.token.auth_time
        && (isPersonal(m)
          ? (d.kind == 'personal' && d.staffId == m.staffId
            && d.staffName is string && d.staffName.size() > 0)
          : (d.kind == 'shared' && d.staffId == null && d.staffName == null));
    }

    // ── memberships: アカウント → 事業所の所属 ─────────────
    // doc id = Firebase Auth の uid
    // 自分の所属だけ読める。クライアントからは作成・変更・削除できない
    // （書き換えられると他事業所のデータを読めてしまうため）。
    match /memberships/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // ── facilities: 事業所と業務データ ───────────────────────
    match /facilities/{facilityId} {
      // 事業所ドキュメント自体は管理者が作る（クライアントは読むだけ）
      allow read: if isMemberOf(facilityId);
      allow create, update, delete: if false;

      // customers / scheduleEntries / scheduleWeeks / attendance /
      // transportRoutes / settings と、後のステップで追加するもの。
      // 職員・メールアドレス・ログイン履歴は下の専用のルールだけで判定する
      // （ここで許すと、どれか 1 つが許せば通るため専用のルールを素通りする）。
      match /{collection}/{docId} {
        allow read: if isMemberOf(facilityId)
          && !(collection in OWN_RULE_COLLECTIONS());
        allow create, update: if isMemberOf(facilityId) && hasAudit()
          && !(collection in OWN_RULE_COLLECTIONS());
        // 顧客は削除しない（在籍終了で扱う）
        allow delete: if isMemberOf(facilityId)
          && !(collection in ['customers'])
          && !(collection in OWN_RULE_COLLECTIONS());
      }

      // ── 職員（ステップ2: 管理者の権限）─────────────────────
      // 氏名・ふりがな・役割・資格・勤務日・送迎の可否は、所属するアカウントなら
      // 誰でも変えられる。在籍・管理者・ログインの許可・メールアドレスの有無など
      // （PROTECTED_STAFF_FIELDS）は管理者だけ。登録も管理者だけ。削除は誰もできない。
      match /staff/{staffId} {
        allow read: if isMemberOf(facilityId);
        allow create: if isAdminOf(facilityId) && hasAudit()
          && request.resource.data.get('isActive', true) == true;
        allow update: if isMemberOf(facilityId) && hasAudit()
          && (isAdminOf(facilityId)
            ? keepsAnAdmin(facilityId, staffId)
            : !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(PROTECTED_STAFF_FIELDS()));
        allow delete: if false;
      }

      // ── ログイン履歴（ステップ2）──────────────────────────
      // doc id = {uid}_{auth_time}（auth_time は実際にログインした時刻。ページを
      // 再読み込みしても変わらないので、1 回のログインにつき 1 件だけになる）。
      // 追記だけ（作った後の書き換え・削除は誰もできない）。自分の分しか作れない。
      // 読めるのは管理者だけ。
      match /loginHistory/{entryId} {
        allow read: if isAdminOf(facilityId);
        allow create: if isMemberOf(facilityId) && validLoginEntry(entryId);
        allow update, delete: if false;
      }

      // ── 業務日誌（ステップ3）: 所属する全員が読める。書くには担当者の記録が要る。
      // 作成日時は作るときだけ付け、後から変えられない。削除は誰もできない。
      match /dailyJournals/{dateKey} {
        allow read: if isMemberOf(facilityId);
        allow create: if isMemberOf(facilityId) && hasAudit()
          && validJournal(dateKey)
          && request.resource.data.createdAt == request.time;
        allow update: if isMemberOf(facilityId) && hasAudit()
          && validJournal(dateKey)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['createdAt', 'date']);
        allow delete: if false;
      }

      // ── 個別支援計画（ステップ3）: 所属する全員が読める。書くには担当者の記録が要る。
      // 同意済みの計画の更新は agreedPlanUpdateOk の形だけ。どの児童の計画かと作成日時は
      // 後から変えられない。削除は誰もできない（履歴として残す）。
      match /supportPlans/{planId} {
        allow read: if isMemberOf(facilityId);
        allow create: if isMemberOf(facilityId) && hasAudit() && validPlan()
          && request.resource.data.createdAt == request.time;
        allow update: if isMemberOf(facilityId) && hasAudit() && validPlan()
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['customerId', 'createdAt'])
          && (resource.data.status != 'agreed' || agreedPlanUpdateOk());
        allow delete: if false;
      }

      // ── 職員の Google メールアドレス（個人情報。管理者だけが読み書きできる）──
      match /staffAccounts/{staffId} {
        allow read: if isAdminOf(facilityId);
        allow create, update: if isAdminOf(facilityId) && hasAudit()
          && validAccountEmail(request.resource.data);
        allow delete: if false;
      }

      // さらに下の階層は誰も読み書きできない（ステップ3で拒否にした）。
      // 使っている場所が無く、所属だけで担当者の記録が無くても書けてしまうため。
      // 下の階層を使うときは、そのコレクション専用のルールを書く。
      // 注意: {rest=**} は 0 階層にも一致するため、{sub} を挟んで
      // 「少なくとも 1 階層深い」パスだけに限定する（上の条件を素通りさせない）。
      match /{collection}/{docId}/{sub}/{rest=**} {
        allow read, write: if false;
      }
    }

    // ── line_linkage: 連携済み（customerId ↔ lineUserId）──
    // doc id = customerId
    // クライアント: 有効な所属のあるアカウントなら read 可（連携状況の同期に使用）。
    //              write も同じ（職員による連携解除のため）。
    //              ステップ2で「認証済みなら誰でも」から締めた（Google ログインで
    //              誰でもアカウントを作れるようになるため）。
    match /line_linkage/{customerId} {
      allow read: if hasValidMembership();

      // 作成・更新は形式検証つき（customerId は doc id と一致必須）
      allow create, update: if hasValidMembership()
        && request.resource.data.customerId == customerId
        && isValidLineUserId(request.resource.data.lineUserId);

      // 連携解除（職員操作）
      allow delete: if hasValidMembership();
    }

    // ── linking_codes: 連携コード（有効期限7日）──────────
    // doc id = code（6桁英数）
    match /linking_codes/{code} {
      allow read: if hasValidMembership();

      // 発行は有効な所属のあるアカウントのみ。code / customerId / expiresAt を必須にする。
      allow create: if hasValidMembership()
        && isValidCode(code)
        && request.resource.data.code == code
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.expiresAt is timestamp;

      // 既発行コードの書き換えは禁止（別コードの再発行で代替する）
      allow update: if false;

      // 失効・取り消しは許可
      allow delete: if hasValidMembership();
    }

    // ── notification_logs: 通知送信ログ（冪等キー兼用）──
    // doc id = {YYYY-MM-DD}_{customerId}
    //
    // 【重要】クライアントからの書き込みを一切許可しない。
    // ここを書き換えられると「送信済み」判定を偽装でき、
    // 二重送信・送信漏れの双方が起こり得る。
    // 作成・更新は Cloud Functions（Admin SDK）のみが行う。
    match /notification_logs/{logId} {
      allow read: if hasValidMembership();
      allow create, update, delete: if false;
    }

    // ── slots: 空き枠の先着応募（Day 13）────────────────
    // doc id = {YYYY-MM-DD}_{欠席児童のcustomerId}
    //
    // 【重要】クライアントからの書き込みを一切許可しない。
    // status / claimedBy を書き換えられると、
    //   - 確定済みの枠を open に戻して横取りする
    //   - 他人を claimedBy に書き込んで枠を奪う
    //   - notifiedList に自分を足して対象外から応募する
    // が可能になる。確定は Cloud Functions の transaction のみが行う。
    // 職員向けの応募状況表示のため read は認証済みに許可する。
    match /slots/{slotId} {
      allow read: if hasValidMembership();
      allow create, update, delete: if false;
    }

    // ── webhook_processed: webhook 冪等キー（Day 13）────
    // LINE の再送による二重確定を防ぐための記録。
    // クライアントが消せると再送で二重処理が通ってしまうため、
    // read も含めて全面拒否（Functions の Admin SDK のみ）。
    match /webhook_processed/{eventId} {
      allow read, write: if false;
    }

    // ── slot_audit: 枠の状態変化の監査ログ（Day 13）─────
    // 不正検知・トラブル調査用。改ざんされると監査の意味が無いため
    // クライアントからの書き込みは禁止。read は職員に許可する。
    match /slot_audit/{auditId} {
      allow read: if hasValidMembership();
      allow create, update, delete: if false;
    }

    // ── slot_admin_targets: 枠ごとの管理者通知先（Day 15）──
    // 管理者の LINE userId（生値）を持つため、read も含め全面拒否。
    // slots は職員が read できるので、そこには置かず別コレクションに分離している。
    match /slot_admin_targets/{slotId} {
      allow read, write: if false;
    }

    // ── 上記以外は全面拒否 ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
