rules_version = '2';

// ============================================================
// LinkDay Firestore セキュリティルール
//
// 【前提】
// - 業務データ（顧客・週間利用計画・出席・送迎計画・設定・職員）は
//   facilities/{facilityId}/ の下に置き、複数の端末で共有する。
//   児童の個人情報を含むため、その事業所に所属するアカウントだけが読み書きできる。
// - 所属は最上位の memberships/{uid}（{ facilityId }）で表す。
//   クライアントは自分の分を読めるだけで、作成・変更はできない
//   （登録は管理者が Firebase コンソール／Admin SDK で行う）。
// - LINE 連携用のコレクション（line_linkage 以下）は、有効な所属のあるアカウントだけ
//   （ステップ2で「認証済みなら誰でも」から締めた）。
// - Cloud Functions は Admin SDK で動作するため、本ルールを
//   バイパスする（lineWebhook は未認証の LINE からの呼び出しだが、
//   x-line-signature の HMAC 検証を通過したものだけが Firestore に書く）。
// - ログインは 2 種類（ステップ2）。
//   共用端末アカウント（事業所の PC・タブレット）: 誰が操作したかはアプリ内で
//     担当者を選んで updatedByStaffId / updatedByStaffName に残す（本人確認ではない）。
//   個人アカウント（職員の Google アカウント）: 担当者はログインした本人に固定。
//     ルールでも本人の職員 ID でしか記録できない（hasAudit）。
//
// 【原則】
// 1. 未認証（request.auth == null）は全コレクション全面拒否。
//    認証済みでも、有効な所属（memberships/{uid}）が無ければ全面拒否
//    （自分の所属の文書を読むことだけはできる）。
// 2. facilities/{facilityId}/** は「ログイン済み かつ その事業所に所属」の場合だけ。
//    「ログイン済みなら誰でも」にはしない。他事業所のデータは読めない。
// 3. 業務データの作成・更新には updatedAt（サーバー時刻）と担当者名を必須にする。
// 4. 顧客・職員は削除しない（在籍終了 = isActive:false）。削除は拒否する。
// 5. 明示的に許可したコレクション以外は全面拒否（最後の match /{document=**}）。
// 6. notification_logs はクライアントから作成・更新・削除できない
//    （冪等キーを兼ねるため、改変されると二重送信が可能になる）。
//    作成は Cloud Functions（Admin SDK）のみ。クライアントは read のみ。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 共通ヘルパー ───────────────────────────────────────
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // 6 桁英数（数字＋大文字英字）の連携コードか
    function isValidCode(code) {
      return code is string && code.matches('^[0-9A-Z]{6}$');
    }

    // LINE userId: 'U' + 32 桁 16 進英数字
    function isValidLineUserId(id) {
      return id is string && id.matches('^U[0-9a-fA-F]{32}$');
    }

    // ── 所属（ステップ2: 個人アカウントを追加）─────────────────
    // memberships/{uid} = { facilityId, kind, staffId, email, createdAt }
    //   kind: 'shared'（共用端末アカウント。kind が無い所属もこれ）
    //       | 'personal'（職員個人の Google アカウント。staffId の本人）
    // 所属を作る・消すのは Cloud Functions だけ（クライアントは書けない）。
    //
    // 【安全の前提】誰でも Firebase のアカウントを作れても（Google ログインを
    // 有効にすると誰でも作れる）、有効な所属が無ければ何も読めず何も書けない。
    // 個人アカウントの所属は、ひも付く職員が「在籍中かつログイン許可」のときだけ
    // 有効とする（在籍終了・ログイン停止は、Functions が所属を消すのを待たずに、
    // その時点から拒否される）。
    function membershipPath() {
      return /databases/$(database)/documents/memberships/$(request.auth.uid);
    }

    function staffPath(facilityId, staffId) {
      return /databases/$(database)/documents/facilities/$(facilityId)/staff/$(staffId);
    }

    function isPersonal(m) {
      return m.get('kind', 'shared') == 'personal';
    }

    // 所属の文書 m が有効か（共用端末なら常に有効。個人なら職員が在籍中かつログイン許可）
    function membershipOk(m) {
      return m.facilityId is string
        && (!isPersonal(m)
          || (m.get('staffId', null) is string
            && exists(staffPath(m.facilityId, m.staffId))
            && get(staffPath(m.facilityId, m.staffId)).data.get('isActive', false) == true
            && get(staffPath(m.facilityId, m.staffId)).data.get('loginEnabled', false) == true));
    }

    // 有効な所属があるか（事業所を問わない。LINE 連携の最上位コレクション用）
    function hasValidMembership() {
      return isSignedIn() && exists(membershipPath())
        && membershipOk(get(membershipPath()).data);
    }

    // その事業所に有効な所属があるか
    function isMemberOf(facilityId) {
      return hasValidMembership()
        && get(membershipPath()).data.facilityId == facilityId;
    }

    // 業務データの書き込みに担当者の記録が付いているか。
    // 個人アカウントは本人の職員 ID でしか記録できない（他人の名前で記録させない）。
    // 例外は画面を開いたときの自動処理（担当者 ID なし・名前「自動」）だけ。
    function hasAudit() {
      let d = request.resource.data;
      let m = get(membershipPath()).data;
      return d.updatedAt == request.time
        && d.updatedByStaffName is string
        && d.updatedByStaffName.size() > 0
        && (d.updatedByStaffId == null || d.updatedByStaffId is string)
        && (!isPersonal(m)
          || d.updatedByStaffId == m.staffId
          || (d.updatedByStaffId == null && d.updatedByStaffName == '自動'));
    }

    // ── memberships: アカウント → 事業所の所属 ─────────────
    // doc id = Firebase Auth の uid
    // 自分の所属だけ読める。クライアントからは作成・変更・削除できない
    // （書き換えられると他事業所のデータを読めてしまうため）。
    match /memberships/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // ── facilities: 事業所と業務データ ───────────────────────
    match /facilities/{facilityId} {
      // 事業所ドキュメント自体は管理者が作る（クライアントは読むだけ）
      allow read: if isMemberOf(facilityId);
      allow create, update, delete: if false;

      // customers / scheduleEntries / scheduleWeeks / attendance /
      // transportRoutes / settings / staff と、後のステップで追加するもの
      match /{collection}/{docId} {
        allow read: if isMemberOf(facilityId);
        allow create, update: if isMemberOf(facilityId) && hasAudit();
        // 顧客・職員は削除しない（在籍終了で扱う）
        allow delete: if isMemberOf(facilityId)
          && !(collection in ['customers', 'staff']);
      }

      // さらに下の階層（後のステップ用）も所属アカウントだけ。
      // 注意: {rest=**} は 0 階層にも一致するため、{sub} を挟んで
      // 「少なくとも 1 階層深い」パスだけに限定する（上の条件を素通りさせない）。
      match /{collection}/{docId}/{sub}/{rest=**} {
        allow read, write: if isMemberOf(facilityId);
      }
    }

    // ── line_linkage: 連携済み（customerId ↔ lineUserId）──
    // doc id = customerId
    // クライアント: 有効な所属のあるアカウントなら read 可（連携状況の同期に使用）。
    //              write も同じ（職員による連携解除のため）。
    //              ステップ2で「認証済みなら誰でも」から締めた（Google ログインで
    //              誰でもアカウントを作れるようになるため）。
    match /line_linkage/{customerId} {
      allow read: if hasValidMembership();

      // 作成・更新は形式検証つき（customerId は doc id と一致必須）
      allow create, update: if hasValidMembership()
        && request.resource.data.customerId == customerId
        && isValidLineUserId(request.resource.data.lineUserId);

      // 連携解除（職員操作）
      allow delete: if hasValidMembership();
    }

    // ── linking_codes: 連携コード（有効期限7日）──────────
    // doc id = code（6桁英数）
    match /linking_codes/{code} {
      allow read: if hasValidMembership();

      // 発行は有効な所属のあるアカウントのみ。code / customerId / expiresAt を必須にする。
      allow create: if hasValidMembership()
        && isValidCode(code)
        && request.resource.data.code == code
        && request.resource.data.customerId is string
        && request.resource.data.customerId.size() > 0
        && request.resource.data.expiresAt is timestamp;

      // 既発行コードの書き換えは禁止（別コードの再発行で代替する）
      allow update: if false;

      // 失効・取り消しは許可
      allow delete: if hasValidMembership();
    }

    // ── notification_logs: 通知送信ログ（冪等キー兼用）──
    // doc id = {YYYY-MM-DD}_{customerId}
    //
    // 【重要】クライアントからの書き込みを一切許可しない。
    // ここを書き換えられると「送信済み」判定を偽装でき、
    // 二重送信・送信漏れの双方が起こり得る。
    // 作成・更新は Cloud Functions（Admin SDK）のみが行う。
    match /notification_logs/{logId} {
      allow read: if hasValidMembership();
      allow create, update, delete: if false;
    }

    // ── slots: 空き枠の先着応募（Day 13）────────────────
    // doc id = {YYYY-MM-DD}_{欠席児童のcustomerId}
    //
    // 【重要】クライアントからの書き込みを一切許可しない。
    // status / claimedBy を書き換えられると、
    //   - 確定済みの枠を open に戻して横取りする
    //   - 他人を claimedBy に書き込んで枠を奪う
    //   - notifiedList に自分を足して対象外から応募する
    // が可能になる。確定は Cloud Functions の transaction のみが行う。
    // 職員向けの応募状況表示のため read は認証済みに許可する。
    match /slots/{slotId} {
      allow read: if hasValidMembership();
      allow create, update, delete: if false;
    }

    // ── webhook_processed: webhook 冪等キー（Day 13）────
    // LINE の再送による二重確定を防ぐための記録。
    // クライアントが消せると再送で二重処理が通ってしまうため、
    // read も含めて全面拒否（Functions の Admin SDK のみ）。
    match /webhook_processed/{eventId} {
      allow read, write: if false;
    }

    // ── slot_audit: 枠の状態変化の監査ログ（Day 13）─────
    // 不正検知・トラブル調査用。改ざんされると監査の意味が無いため
    // クライアントからの書き込みは禁止。read は職員に許可する。
    match /slot_audit/{auditId} {
      allow read: if hasValidMembership();
      allow create, update, delete: if false;
    }

    // ── slot_admin_targets: 枠ごとの管理者通知先（Day 15）──
    // 管理者の LINE userId（生値）を持つため、read も含め全面拒否。
    // slots は職員が read できるので、そこには置かず別コレクションに分離している。
    match /slot_admin_targets/{slotId} {
      allow read, write: if false;
    }

    // ── 上記以外は全面拒否 ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
