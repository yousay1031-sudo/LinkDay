{
  "compilerOptions": {
    "module": "commonjs",
    "lib": ["es2022", "dom"],
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"]
  },
  "compileOnSave": true,
  "include": ["src"],
  "exclude": ["lib", "node_modules", "test"]
}
